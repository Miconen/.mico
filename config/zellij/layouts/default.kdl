// Managed by home-manager (see home/tools.nix). Edit it in ~/.mico, not here.
//
// Referenced by `default_layout "default"` in config.kdl, which is what the
// shell's `zellij attach --create main` picks up - `attach` cannot take --layout.
//
// NOTE: in a layout file everything must live inside the top-level `layout`
// node, including tab_template and the swap layouts. The flat form shown by
// `zellij setup --dump-swap-layout` is a different schema, for standalone
// .swap.kdl files only.
layout {
  // compact-bar instead of zellij's default tab-bar + status-bar pair, so the
  // UI costs one row rather than two.
  tab_template name="ui" {
    pane size=1 borderless=true {
      plugin location="zellij:compact-bar"
    }
    children
  }

  ui {
    pane
  }

  // Swap layouts, cycled with Alt-[ and Alt-].
  //
  // config.kdl has bound those two keys since day one, but with no
  // swap_tiled_layout defined they did nothing at all. These are zellij's own
  // defaults, re-templated onto compact-bar.
  swap_tiled_layout name="vertical" {
    ui max_panes=5 {
      pane split_direction="vertical" {
        pane
        pane { children; }
      }
    }
    ui max_panes=8 {
      pane split_direction="vertical" {
        pane { children; }
        pane { pane; pane; pane; pane; }
      }
    }
    ui max_panes=12 {
      pane split_direction="vertical" {
        pane { children; }
        pane { pane; pane; pane; pane; }
        pane { pane; pane; pane; pane; }
      }
    }
  }

  swap_tiled_layout name="horizontal" {
    ui max_panes=4 {
      pane
      pane
    }
    ui max_panes=8 {
      pane {
        pane split_direction="vertical" { children; }
        pane split_direction="vertical" { pane; pane; pane; pane; }
      }
    }
    ui max_panes=12 {
      pane {
        pane split_direction="vertical" { children; }
        pane split_direction="vertical" { pane; pane; pane; pane; }
        pane split_direction="vertical" { pane; pane; pane; pane; }
      }
    }
  }

  swap_tiled_layout name="stacked" {
    ui min_panes=5 {
      pane split_direction="vertical" {
        pane
        pane stacked=true { children; }
      }
    }
  }

  swap_floating_layout name="staggered" {
    floating_panes
  }

  swap_floating_layout name="enlarged" {
    floating_panes max_panes=10 {
      pane { x "5%"; y 1; width "90%"; height "90%"; }
      pane { x "5%"; y 2; width "90%"; height "90%"; }
      pane { x "5%"; y 3; width "90%"; height "90%"; }
      pane { x "5%"; y 4; width "90%"; height "90%"; }
      pane { x "5%"; y 5; width "90%"; height "90%"; }
      pane { x "5%"; y 6; width "90%"; height "90%"; }
      pane { x "5%"; y 7; width "90%"; height "90%"; }
      pane { x "5%"; y 8; width "90%"; height "90%"; }
      pane { x "5%"; y 9; width "90%"; height "90%"; }
      pane { x 10; y 10; width "90%"; height "90%"; }
    }
  }
}
